#ifndef SILICA_ATOMIC_CLH
#define SILICA_ATOMIC_CLH

// Atomic float addition for global memory via integer CAS loop
inline void atomic_add_float_global(volatile __global float* addr, float val) {
    union {
        unsigned int u32;
        float        f32;
    } current, next;

    do {
        current.f32 = *addr;
        next.f32    = current.f32 + val;
    } while (atomic_cmpxchg((volatile __global unsigned int*)addr, current.u32, next.u32) != current.u32);
}

// Atomic float addition for local LDS memory via integer CAS loop
inline void atomic_add_float_local(volatile __local float* addr, float val) {
    union {
        unsigned int u32;
        float        f32;
    } current, next;

    do {
        current.f32 = *addr;
        next.f32    = current.f32 + val;
    } while (atomic_cmpxchg((volatile __local unsigned int*)addr, current.u32, next.u32) != current.u32);
}

// Atomic float minimum for global memory
inline void atomic_min_float_global(volatile __global float* addr, float val) {
    union {
        unsigned int u32;
        float        f32;
    } current, next;

    do {
        current.f32 = *addr;
        if (current.f32 <= val) return;
        next.f32 = val;
    } while (atomic_cmpxchg((volatile __global unsigned int*)addr, current.u32, next.u32) != current.u32);
}

// Atomic float maximum for global memory
inline void atomic_max_float_global(volatile __global float* addr, float val) {
    union {
        unsigned int u32;
        float        f32;
    } current, next;

    do {
        current.f32 = *addr;
        if (current.f32 >= val) return;
        next.f32 = val;
    } while (atomic_cmpxchg((volatile __global unsigned int*)addr, current.u32, next.u32) != current.u32);
}

#endif // SILICA_ATOMIC_CLH
