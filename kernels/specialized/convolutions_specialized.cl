// ============================================================================
// 3D Multiscale Hessian Matrix Gaussian Second Derivatives (Dxx, Dyy, Dzz, Dxy, Dxz, Dyz)
// ============================================================================

// 3D Hessian Dxx Second Derivative: Radius 1 (Window 3)
__kernel void kernel_hessian3d_dxx_r1(
    __global const float* input, __global float* out_dxx,
    __constant const float* dxx_weights, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cx = clamp_i(x + (-1), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[0]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[1]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[2]; }
    out_dxx[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
}

// 3D Hessian Dyy Second Derivative: Radius 1 (Window 3)
__kernel void kernel_hessian3d_dyy_r1(
    __global const float* input, __global float* out_dyy,
    __constant const float* dyy_weights, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[0]; }
    { int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[1]; }
    { int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[2]; }
    out_dyy[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
}

// 3D Hessian Dzz Second Derivative: Radius 1 (Window 3)
__kernel void kernel_hessian3d_dzz_r1(
    __global const float* input, __global float* out_dzz,
    __constant const float* dzz_weights, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cz = clamp_i(z + (-1), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[0]; }
    { int cz = clamp_i(z + (0), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[1]; }
    { int cz = clamp_i(z + (1), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[2]; }
    out_dzz[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
}

// 3D Hessian Dxy Mixed Derivative: Radius 1 (Window 3)
__kernel void kernel_hessian3d_dxy_r1(
    __global const float* input, __global float* out_dxy,
    __constant const float* dxy_weights, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cx = clamp_i(x + (-1), 0, nx - 1); int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[0]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[1]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[2]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[3]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[4]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[5]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[6]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[7]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[8]; }
    out_dxy[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
}

// 3D Hessian Dxx Second Derivative: Radius 2 (Window 5)
__kernel void kernel_hessian3d_dxx_r2(
    __global const float* input, __global float* out_dxx,
    __constant const float* dxx_weights, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cx = clamp_i(x + (-2), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[0]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[1]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[2]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[3]; }
    { int cx = clamp_i(x + (2), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[4]; }
    out_dxx[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
}

// 3D Hessian Dyy Second Derivative: Radius 2 (Window 5)
__kernel void kernel_hessian3d_dyy_r2(
    __global const float* input, __global float* out_dyy,
    __constant const float* dyy_weights, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cy = clamp_i(y + (-2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[0]; }
    { int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[1]; }
    { int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[2]; }
    { int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[3]; }
    { int cy = clamp_i(y + (2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[4]; }
    out_dyy[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
}

