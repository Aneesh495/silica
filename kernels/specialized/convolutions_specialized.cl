    { int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[4]; }
    { int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[5]; }
    { int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[6]; }
    { int cy = clamp_i(y + (2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[7]; }
