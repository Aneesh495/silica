    { int cx = clamp_i(x + (3), 0, nx - 1); int cy = clamp_i(y + (3), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[48]; }
