    { int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)x] * weights[1]; }
    { int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)x] * weights[2]; }
