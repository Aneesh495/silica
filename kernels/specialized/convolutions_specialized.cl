// Direct 3D Non-Separable Convolution: Kernel 7x7x7
__kernel void kernel_conv3d_direct_7x7x7(
    __global const float* input, __global float* output,
    __constant const float* mask, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cx = clamp_i(x + (-3), 0, nx - 1); int cy = clamp_i(y + (-3), 0, ny - 1); int cz = clamp_i(z + (-3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[0]; }
    { int cx = clamp_i(x + (-2), 0, nx - 1); int cy = clamp_i(y + (-3), 0, ny - 1); int cz = clamp_i(z + (-3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[1]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); int cy = clamp_i(y + (-3), 0, ny - 1); int cz = clamp_i(z + (-3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[2]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); int cy = clamp_i(y + (-3), 0, ny - 1); int cz = clamp_i(z + (-3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[3]; }
