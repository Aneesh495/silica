    { int cz = clamp_i(z + (-3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[0]; }
    { int cz = clamp_i(z + (-2), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[1]; }
    { int cz = clamp_i(z + (-1), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[2]; }
