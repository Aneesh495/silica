// Direct 2D Non-Separable Convolution: Kernel 11x11
__kernel void kernel_conv2d_direct_11x11(
    __global const float* input, __global float* output,
    __constant const float* mask, const int width, const int height) {
    int x = get_global_id(0); int y = get_global_id(1);
    if (x >= width || y >= height) return;
