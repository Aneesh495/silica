// Direct 2D Non-Separable Convolution: Kernel 7x7
__kernel void kernel_conv2d_direct_7x7(
    __global const float* input, __global float* output,
    __constant const float* mask, const int width, const int height) {
    int x = get_global_id(0); int y = get_global_id(1);
    if (x >= width || y >= height) return;
    float sum = 0.0f;
    { int cx = clamp_i(x + (-3), 0, width - 1); int cy = clamp_i(y + (-3), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[0]; }
    { int cx = clamp_i(x + (-2), 0, width - 1); int cy = clamp_i(y + (-3), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[1]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (-3), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[2]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (-3), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[3]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (-3), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[4]; }
    { int cx = clamp_i(x + (2), 0, width - 1); int cy = clamp_i(y + (-3), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[5]; }
    { int cx = clamp_i(x + (3), 0, width - 1); int cy = clamp_i(y + (-3), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[6]; }
    { int cx = clamp_i(x + (-3), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[7]; }
    { int cx = clamp_i(x + (-2), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[8]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[9]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[10]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[11]; }
    { int cx = clamp_i(x + (2), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[12]; }
    { int cx = clamp_i(x + (3), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[13]; }
    { int cx = clamp_i(x + (-3), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[14]; }
    { int cx = clamp_i(x + (-2), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[15]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[16]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[17]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[18]; }
    { int cx = clamp_i(x + (2), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[19]; }
    { int cx = clamp_i(x + (3), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[20]; }
    { int cx = clamp_i(x + (-3), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[21]; }
    { int cx = clamp_i(x + (-2), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[22]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[23]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[24]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[25]; }
    { int cx = clamp_i(x + (2), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[26]; }
    { int cx = clamp_i(x + (3), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[27]; }
