// ============================================================================
// Multiscale 2D Gabor Filter Bank: 16 Orientations x 4 Frequency Bands
// ============================================================================

// 2D Gabor Filter: Freq Band 0 (Lambda 4.0), Orientation 0 (Theta 0.0000 rad)
__kernel void kernel_gabor_f0_o0(
    __global const float* input, __global float2* output,
    const int width, const int height, const float sigma, const float gamma, const float psi) {
    int x = get_global_id(0); int y = get_global_id(1);
    if (x >= width || y >= height) return;
    const float theta = 0.0f;
    const float lambda = 4.0f;
    const int radius = 2;
    float cos_t = cos(theta); float sin_t = sin(theta);
    float2 acc = (float2)(0.0f, 0.0f);
    float sigma_sq = sigma * sigma;
    for (int dy = -radius; dy <= radius; ++dy) {
        int cy = clamp_i(y + dy, 0, height - 1);
        for (int dx = -radius; dx <= radius; ++dx) {
            int cx = clamp_i(x + dx, 0, width - 1);
            float x_p =  (float)dx * cos_t + (float)dy * sin_t;
            float y_p = -(float)dx * sin_t + (float)dy * cos_t;
            float envelope = exp(- (x_p * x_p + gamma * gamma * y_p * y_p) / (2.0f * sigma_sq));
            float carrier = (2.0f * PI_F * x_p / lambda) + psi;
            float val = input[(size_t)cy * (size_t)width + (size_t)cx];
            acc.x += val * envelope * cos(carrier);
            acc.y += val * envelope * sin(carrier);
        }
    }
    output[(size_t)y * (size_t)width + (size_t)x] = acc;
}

// 2D Gabor Filter: Freq Band 0 (Lambda 4.0), Orientation 1 (Theta 0.1963 rad)
__kernel void kernel_gabor_f0_o1(
    __global const float* input, __global float2* output,
    const int width, const int height, const float sigma, const float gamma, const float psi) {
    int x = get_global_id(0); int y = get_global_id(1);
    if (x >= width || y >= height) return;
    const float theta = 0.19634954084936207f;
    const float lambda = 4.0f;
    const int radius = 2;
    float cos_t = cos(theta); float sin_t = sin(theta);
    float2 acc = (float2)(0.0f, 0.0f);
    float sigma_sq = sigma * sigma;
    for (int dy = -radius; dy <= radius; ++dy) {
        int cy = clamp_i(y + dy, 0, height - 1);
        for (int dx = -radius; dx <= radius; ++dx) {
            int cx = clamp_i(x + dx, 0, width - 1);
            float x_p =  (float)dx * cos_t + (float)dy * sin_t;
            float y_p = -(float)dx * sin_t + (float)dy * cos_t;
            float envelope = exp(- (x_p * x_p + gamma * gamma * y_p * y_p) / (2.0f * sigma_sq));
            float carrier = (2.0f * PI_F * x_p / lambda) + psi;
            float val = input[(size_t)cy * (size_t)width + (size_t)cx];
            acc.x += val * envelope * cos(carrier);
            acc.y += val * envelope * sin(carrier);
        }
    }
    output[(size_t)y * (size_t)width + (size_t)x] = acc;
}

// 2D Gabor Filter: Freq Band 0 (Lambda 4.0), Orientation 2 (Theta 0.3927 rad)
__kernel void kernel_gabor_f0_o2(
    __global const float* input, __global float2* output,
    const int width, const int height, const float sigma, const float gamma, const float psi) {
    int x = get_global_id(0); int y = get_global_id(1);
