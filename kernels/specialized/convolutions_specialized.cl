    { int cz = ((z + (5)) % depth + depth) % depth; sum += input[(size_t)cz * slice + xy] * weights[20]; }
    { int cz = ((z + (6)) % depth + depth) % depth; sum += input[(size_t)cz * slice + xy] * weights[21]; }
    { int cz = ((z + (7)) % depth + depth) % depth; sum += input[(size_t)cz * slice + xy] * weights[22]; }
    { int cz = ((z + (8)) % depth + depth) % depth; sum += input[(size_t)cz * slice + xy] * weights[23]; }
    { int cz = ((z + (9)) % depth + depth) % depth; sum += input[(size_t)cz * slice + xy] * weights[24]; }
    { int cz = ((z + (10)) % depth + depth) % depth; sum += input[(size_t)cz * slice + xy] * weights[25]; }
    { int cz = ((z + (11)) % depth + depth) % depth; sum += input[(size_t)cz * slice + xy] * weights[26]; }
    { int cz = ((z + (12)) % depth + depth) % depth; sum += input[(size_t)cz * slice + xy] * weights[27]; }
    { int cz = ((z + (13)) % depth + depth) % depth; sum += input[(size_t)cz * slice + xy] * weights[28]; }
    { int cz = ((z + (14)) % depth + depth) % depth; sum += input[(size_t)cz * slice + xy] * weights[29]; }
    { int cz = ((z + (15)) % depth + depth) % depth; sum += input[(size_t)cz * slice + xy] * weights[30]; }
    output[(size_t)z * slice + xy] = sum;
}

// Strided 2D Downsampling Convolution: Radius 1, Stride 2
__kernel void kernel_conv2d_strided_r1_s2(
    __global const float* input, __global float* output,
    __constant const float* weights, const int in_w, const int in_h, const int out_w, const int out_h) {
    int ox = get_global_id(0); int oy = get_global_id(1);
    if (ox >= out_w || oy >= out_h) return;
    int cx_center = ox * 2; int cy_center = oy * 2;
    float sum = 0.0f;
    { int ix = clamp_i(cx_center + (-1), 0, in_w - 1); int iy = clamp_i(cy_center + (-1), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[0]; }
    { int ix = clamp_i(cx_center + (0), 0, in_w - 1); int iy = clamp_i(cy_center + (-1), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[1]; }
    { int ix = clamp_i(cx_center + (1), 0, in_w - 1); int iy = clamp_i(cy_center + (-1), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[2]; }
    { int ix = clamp_i(cx_center + (-1), 0, in_w - 1); int iy = clamp_i(cy_center + (0), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[3]; }
    { int ix = clamp_i(cx_center + (0), 0, in_w - 1); int iy = clamp_i(cy_center + (0), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[4]; }
    { int ix = clamp_i(cx_center + (1), 0, in_w - 1); int iy = clamp_i(cy_center + (0), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[5]; }
    { int ix = clamp_i(cx_center + (-1), 0, in_w - 1); int iy = clamp_i(cy_center + (1), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[6]; }
    { int ix = clamp_i(cx_center + (0), 0, in_w - 1); int iy = clamp_i(cy_center + (1), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[7]; }
    { int ix = clamp_i(cx_center + (1), 0, in_w - 1); int iy = clamp_i(cy_center + (1), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[8]; }
    output[(size_t)oy * (size_t)out_w + (size_t)ox] = sum;
}

