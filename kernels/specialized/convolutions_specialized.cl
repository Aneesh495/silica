    __constant const float* dyy_weights, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cy = clamp_i(y + (-4), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[0]; }
    { int cy = clamp_i(y + (-3), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[1]; }
    { int cy = clamp_i(y + (-2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[2]; }
    { int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[3]; }
    { int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[4]; }
    { int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[5]; }
    { int cy = clamp_i(y + (2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[6]; }
    { int cy = clamp_i(y + (3), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[7]; }
    { int cy = clamp_i(y + (4), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[8]; }
    out_dyy[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
