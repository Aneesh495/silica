// ============================================================================
// 2D Steerable Pyramid and Multi-Orientation Oriented Energy Filters
// ============================================================================

// Steerable Directional Filter: Orientation 0 (Angle 0.0000 rad)
__kernel void kernel_steerable_filter_orient_0(
    __global const float* input, __global float* output,
    const int width, const int height, const float sigma, const int radius) {
    int x = get_global_id(0); int y = get_global_id(1);
    if (x >= width || y >= height) return;
    const float theta = 0.0f;
    float cos_t = cos(theta); float sin_t = sin(theta);
    float sum = 0.0f; float sigma_sq = sigma * sigma;
    for (int dy = -radius; dy <= radius; ++dy) {
        int cy = clamp_i(y + dy, 0, height - 1);
        for (int dx = -radius; dx <= radius; ++dx) {
            int cx = clamp_i(x + dx, 0, width - 1);
            float u = (float)dx * cos_t + (float)dy * sin_t;
            float v = -(float)dx * sin_t + (float)dy * cos_t;
            // 1st order Gaussian directional derivative
            float g_dir = -u * exp(- (u * u + v * v) / (2.0f * sigma_sq)) / (2.0f * PI_F * sigma_sq * sigma_sq);
            sum += input[(size_t)cy * (size_t)width + (size_t)cx] * g_dir;
        }
    }
    output[(size_t)y * (size_t)width + (size_t)x] = sum;
}

