    { int ix = clamp_i(cx_center + (-2), 0, in_w - 1); int iy = clamp_i(cy_center + (2), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[20]; }
    { int ix = clamp_i(cx_center + (-1), 0, in_w - 1); int iy = clamp_i(cy_center + (2), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[21]; }
