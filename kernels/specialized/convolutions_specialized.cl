    { int cy = clamp_i(y + (5), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[10]; }
    out_dyy[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
