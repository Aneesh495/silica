#include "common/math.clh"
#include "common/memory.clh"

// ============================================================================
// Comprehensive Suite of Separable, Strided, Dilated, and Steerable Convolutions
// ============================================================================

// 2D Horizontal Convolution: Radius 1 (Window 3), Type float, Boundary clamp
__kernel void kernel_conv2d_h_r1_float_clamp(
    __global const float* input, __global float* output,
    __constant const float* weights, const int width, const int height) {
    int x = get_global_id(0); int y = get_global_id(1);
    if (x >= width || y >= height) return;
    float sum = 0.0f; size_t row_base = (size_t)y * (size_t)width;
    { int cx = clamp_i(x + (-1), 0, width - 1); sum += input[row_base + cx] * weights[0]; }
    { int cx = clamp_i(x + (0), 0, width - 1); sum += input[row_base + cx] * weights[1]; }
    { int cx = clamp_i(x + (1), 0, width - 1); sum += input[row_base + cx] * weights[2]; }
    output[row_base + x] = sum;
}

// 2D Vertical Convolution: Radius 1 (Window 3), Type float, Boundary clamp
__kernel void kernel_conv2d_v_r1_float_clamp(
    __global const float* input, __global float* output,
    __constant const float* weights, const int width, const int height) {
    int x = get_global_id(0); int y = get_global_id(1);
    if (x >= width || y >= height) return;
    float sum = 0.0f;
    { int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)x] * weights[0]; }
    { int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)x] * weights[1]; }
    { int cy = clamp_i(y + (1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)x] * weights[2]; }
    output[(size_t)y * (size_t)width + (size_t)x] = sum;
}

// 3D Depth Z Convolution: Radius 1 (Window 3), Type float, Boundary clamp
__kernel void kernel_conv3d_z_r1_float_clamp(
    __global const float* input, __global float* output,
    __constant const float* weights, const int width, const int height, const int depth) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= width || y >= height || z >= depth) return;
    float sum = 0.0f; size_t slice = (size_t)width * (size_t)height; size_t xy = (size_t)y * (size_t)width + (size_t)x;
    { int cz = clamp_i(z + (-1), 0, depth - 1); sum += input[(size_t)cz * slice + xy] * weights[0]; }
    { int cz = clamp_i(z + (0), 0, depth - 1); sum += input[(size_t)cz * slice + xy] * weights[1]; }
    { int cz = clamp_i(z + (1), 0, depth - 1); sum += input[(size_t)cz * slice + xy] * weights[2]; }
    output[(size_t)z * slice + xy] = sum;
}

// 2D Horizontal Convolution: Radius 2 (Window 5), Type float, Boundary clamp
__kernel void kernel_conv2d_h_r2_float_clamp(
    __global const float* input, __global float* output,
    __constant const float* weights, const int width, const int height) {
    int x = get_global_id(0); int y = get_global_id(1);
    if (x >= width || y >= height) return;
    float sum = 0.0f; size_t row_base = (size_t)y * (size_t)width;
    { int cx = clamp_i(x + (-2), 0, width - 1); sum += input[row_base + cx] * weights[0]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); sum += input[row_base + cx] * weights[1]; }
    { int cx = clamp_i(x + (0), 0, width - 1); sum += input[row_base + cx] * weights[2]; }
    { int cx = clamp_i(x + (1), 0, width - 1); sum += input[row_base + cx] * weights[3]; }
    { int cx = clamp_i(x + (2), 0, width - 1); sum += input[row_base + cx] * weights[4]; }
    output[row_base + x] = sum;
}

