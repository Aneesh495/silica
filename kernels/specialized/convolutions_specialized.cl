    { int ix = clamp_i(cx_center + (3), 0, in_w - 1); int iy = clamp_i(cy_center + (2), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[85]; }
    { int ix = clamp_i(cx_center + (4), 0, in_w - 1); int iy = clamp_i(cy_center + (2), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[86]; }
    { int ix = clamp_i(cx_center + (5), 0, in_w - 1); int iy = clamp_i(cy_center + (2), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[87]; }
    { int ix = clamp_i(cx_center + (-5), 0, in_w - 1); int iy = clamp_i(cy_center + (3), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[88]; }
    { int ix = clamp_i(cx_center + (-4), 0, in_w - 1); int iy = clamp_i(cy_center + (3), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[89]; }
    { int ix = clamp_i(cx_center + (-3), 0, in_w - 1); int iy = clamp_i(cy_center + (3), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[90]; }
    { int ix = clamp_i(cx_center + (-2), 0, in_w - 1); int iy = clamp_i(cy_center + (3), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[91]; }
    { int ix = clamp_i(cx_center + (-1), 0, in_w - 1); int iy = clamp_i(cy_center + (3), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[92]; }
    { int ix = clamp_i(cx_center + (0), 0, in_w - 1); int iy = clamp_i(cy_center + (3), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[93]; }
    { int ix = clamp_i(cx_center + (1), 0, in_w - 1); int iy = clamp_i(cy_center + (3), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[94]; }
    { int ix = clamp_i(cx_center + (2), 0, in_w - 1); int iy = clamp_i(cy_center + (3), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[95]; }
    { int ix = clamp_i(cx_center + (3), 0, in_w - 1); int iy = clamp_i(cy_center + (3), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[96]; }
    { int ix = clamp_i(cx_center + (4), 0, in_w - 1); int iy = clamp_i(cy_center + (3), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[97]; }
    { int ix = clamp_i(cx_center + (5), 0, in_w - 1); int iy = clamp_i(cy_center + (3), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[98]; }
    { int ix = clamp_i(cx_center + (-5), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[99]; }
    { int ix = clamp_i(cx_center + (-4), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[100]; }
    { int ix = clamp_i(cx_center + (-3), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[101]; }
    { int ix = clamp_i(cx_center + (-2), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[102]; }
    { int ix = clamp_i(cx_center + (-1), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[103]; }
    { int ix = clamp_i(cx_center + (0), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[104]; }
    { int ix = clamp_i(cx_center + (1), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[105]; }
    { int ix = clamp_i(cx_center + (2), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[106]; }
    { int ix = clamp_i(cx_center + (3), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[107]; }
    { int ix = clamp_i(cx_center + (4), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[108]; }
    { int ix = clamp_i(cx_center + (5), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[109]; }
    { int ix = clamp_i(cx_center + (-5), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[110]; }
    { int ix = clamp_i(cx_center + (-4), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[111]; }
    { int ix = clamp_i(cx_center + (-3), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[112]; }
    { int ix = clamp_i(cx_center + (-2), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[113]; }
    { int ix = clamp_i(cx_center + (-1), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[114]; }
    { int ix = clamp_i(cx_center + (0), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[115]; }
    { int ix = clamp_i(cx_center + (1), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[116]; }
    { int ix = clamp_i(cx_center + (2), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[117]; }
    { int ix = clamp_i(cx_center + (3), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[118]; }
    { int ix = clamp_i(cx_center + (4), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[119]; }
    { int ix = clamp_i(cx_center + (5), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[120]; }
    output[(size_t)oy * (size_t)out_w + (size_t)ox] = sum;
}

// Direct 2D Non-Separable Convolution: Kernel 3x3
__kernel void kernel_conv2d_direct_3x3(
    __global const float* input, __global float* output,
    __constant const float* mask, const int width, const int height) {
    int x = get_global_id(0); int y = get_global_id(1);
    if (x >= width || y >= height) return;
    float sum = 0.0f;
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[0]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[1]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[2]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[3]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[4]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[5]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[6]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[7]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[8]; }
    output[(size_t)y * (size_t)width + (size_t)x] = sum;
}

// Direct 2D Non-Separable Convolution: Kernel 5x5
__kernel void kernel_conv2d_direct_5x5(
    __global const float* input, __global float* output,
    __constant const float* mask, const int width, const int height) {
    int x = get_global_id(0); int y = get_global_id(1);
    if (x >= width || y >= height) return;
    float sum = 0.0f;
    { int cx = clamp_i(x + (-2), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[0]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[1]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[2]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[3]; }
    { int cx = clamp_i(x + (2), 0, width - 1); int cy = clamp_i(y + (-2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[4]; }
    { int cx = clamp_i(x + (-2), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[5]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[6]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[7]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[8]; }
    { int cx = clamp_i(x + (2), 0, width - 1); int cy = clamp_i(y + (-1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[9]; }
    { int cx = clamp_i(x + (-2), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[10]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[11]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[12]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[13]; }
    { int cx = clamp_i(x + (2), 0, width - 1); int cy = clamp_i(y + (0), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[14]; }
    { int cx = clamp_i(x + (-2), 0, width - 1); int cy = clamp_i(y + (1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[15]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[16]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[17]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[18]; }
    { int cx = clamp_i(x + (2), 0, width - 1); int cy = clamp_i(y + (1), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[19]; }
    { int cx = clamp_i(x + (-2), 0, width - 1); int cy = clamp_i(y + (2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[20]; }
    { int cx = clamp_i(x + (-1), 0, width - 1); int cy = clamp_i(y + (2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[21]; }
    { int cx = clamp_i(x + (0), 0, width - 1); int cy = clamp_i(y + (2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[22]; }
    { int cx = clamp_i(x + (1), 0, width - 1); int cy = clamp_i(y + (2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[23]; }
    { int cx = clamp_i(x + (2), 0, width - 1); int cy = clamp_i(y + (2), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[24]; }
    output[(size_t)y * (size_t)width + (size_t)x] = sum;
