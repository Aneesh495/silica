    { int cx = clamp_i(x + (-5), 0, width - 1); int cy = clamp_i(y + (-5), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[0]; }
    { int cx = clamp_i(x + (-4), 0, width - 1); int cy = clamp_i(y + (-5), 0, height - 1); sum += input[(size_t)cy * (size_t)width + (size_t)cx] * mask[1]; }
