    float sum = 0.0f;
    { int c = clamp_i((int)gid + (-2), 0, (int)length - 1); sum += input[c] * weights[0]; }
    { int c = clamp_i((int)gid + (-1), 0, (int)length - 1); sum += input[c] * weights[1]; }
    { int c = clamp_i((int)gid + (0), 0, (int)length - 1); sum += input[c] * weights[2]; }
    { int c = clamp_i((int)gid + (1), 0, (int)length - 1); sum += input[c] * weights[3]; }
    { int c = clamp_i((int)gid + (2), 0, (int)length - 1); sum += input[c] * weights[4]; }
    output[gid] = sum;
}

