    { int ix = clamp_i(cx_center + (5), 0, in_w - 1); int iy = clamp_i(cy_center + (4), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[109]; }
    { int ix = clamp_i(cx_center + (-5), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[110]; }
    { int ix = clamp_i(cx_center + (-4), 0, in_w - 1); int iy = clamp_i(cy_center + (5), 0, in_h - 1); sum += input[(size_t)iy * (size_t)in_w + (size_t)ix] * weights[111]; }
