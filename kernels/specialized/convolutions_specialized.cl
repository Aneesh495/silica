// 3D Hessian Dxy Mixed Derivative: Radius 2 (Window 5)
__kernel void kernel_hessian3d_dxy_r2(
    __global const float* input, __global float* out_dxy,
    __constant const float* dxy_weights, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cx = clamp_i(x + (-2), 0, nx - 1); int cy = clamp_i(y + (-2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[0]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); int cy = clamp_i(y + (-2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[1]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); int cy = clamp_i(y + (-2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[2]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); int cy = clamp_i(y + (-2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[3]; }
    { int cx = clamp_i(x + (2), 0, nx - 1); int cy = clamp_i(y + (-2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[4]; }
    { int cx = clamp_i(x + (-2), 0, nx - 1); int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[5]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[6]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[7]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[8]; }
    { int cx = clamp_i(x + (2), 0, nx - 1); int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[9]; }
    { int cx = clamp_i(x + (-2), 0, nx - 1); int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[10]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[11]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[12]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[13]; }
    { int cx = clamp_i(x + (2), 0, nx - 1); int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[14]; }
    { int cx = clamp_i(x + (-2), 0, nx - 1); int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[15]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[16]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[17]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[18]; }
    { int cx = clamp_i(x + (2), 0, nx - 1); int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[19]; }
    { int cx = clamp_i(x + (-2), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[20]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[21]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[22]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[23]; }
    { int cx = clamp_i(x + (2), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)cx] * dxy_weights[24]; }
    out_dxy[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
}

// 3D Hessian Dxx Second Derivative: Radius 3 (Window 7)
__kernel void kernel_hessian3d_dxx_r3(
    __global const float* input, __global float* out_dxx,
    __constant const float* dxx_weights, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cx = clamp_i(x + (-3), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[0]; }
    { int cx = clamp_i(x + (-2), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[1]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[2]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[3]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[4]; }
    { int cx = clamp_i(x + (2), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[5]; }
    { int cx = clamp_i(x + (3), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[6]; }
    out_dxx[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
}

// 3D Hessian Dyy Second Derivative: Radius 3 (Window 7)
__kernel void kernel_hessian3d_dyy_r3(
    __global const float* input, __global float* out_dyy,
    __constant const float* dyy_weights, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cy = clamp_i(y + (-3), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[0]; }
    { int cy = clamp_i(y + (-2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[1]; }
    { int cy = clamp_i(y + (-1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[2]; }
    { int cy = clamp_i(y + (0), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[3]; }
    { int cy = clamp_i(y + (1), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[4]; }
    { int cy = clamp_i(y + (2), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[5]; }
    { int cy = clamp_i(y + (3), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[6]; }
    out_dyy[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
}

