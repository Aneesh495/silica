    { int cz = clamp_i(z + (0), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[2]; }
    { int cz = clamp_i(z + (1), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[3]; }
    { int cz = clamp_i(z + (2), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[4]; }
    out_dzz[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
