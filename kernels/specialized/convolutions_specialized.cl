// 3D Hessian Dxx Second Derivative: Radius 4 (Window 9)
__kernel void kernel_hessian3d_dxx_r4(
    __global const float* input, __global float* out_dxx,
    __constant const float* dxx_weights, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cx = clamp_i(x + (-4), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[0]; }
    { int cx = clamp_i(x + (-3), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[1]; }
    { int cx = clamp_i(x + (-2), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[2]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[3]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[4]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[5]; }
    { int cx = clamp_i(x + (2), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[6]; }
    { int cx = clamp_i(x + (3), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[7]; }
    { int cx = clamp_i(x + (4), 0, nx - 1); sum += input[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)cx] * dxx_weights[8]; }
    out_dxx[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
}

// 3D Hessian Dyy Second Derivative: Radius 4 (Window 9)
__kernel void kernel_hessian3d_dyy_r4(
