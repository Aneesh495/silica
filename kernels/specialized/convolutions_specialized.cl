    { int cx = clamp_i(x + (1), 0, nx - 1); int cy = clamp_i(y + (1), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[326]; }
    { int cx = clamp_i(x + (2), 0, nx - 1); int cy = clamp_i(y + (1), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[327]; }
    { int cx = clamp_i(x + (3), 0, nx - 1); int cy = clamp_i(y + (1), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[328]; }
    { int cx = clamp_i(x + (-3), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[329]; }
    { int cx = clamp_i(x + (-2), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[330]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[331]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[332]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[333]; }
    { int cx = clamp_i(x + (2), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[334]; }
    { int cx = clamp_i(x + (3), 0, nx - 1); int cy = clamp_i(y + (2), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[335]; }
    { int cx = clamp_i(x + (-3), 0, nx - 1); int cy = clamp_i(y + (3), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[336]; }
    { int cx = clamp_i(x + (-2), 0, nx - 1); int cy = clamp_i(y + (3), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[337]; }
    { int cx = clamp_i(x + (-1), 0, nx - 1); int cy = clamp_i(y + (3), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[338]; }
    { int cx = clamp_i(x + (0), 0, nx - 1); int cy = clamp_i(y + (3), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[339]; }
    { int cx = clamp_i(x + (1), 0, nx - 1); int cy = clamp_i(y + (3), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[340]; }
    { int cx = clamp_i(x + (2), 0, nx - 1); int cy = clamp_i(y + (3), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[341]; }
    { int cx = clamp_i(x + (3), 0, nx - 1); int cy = clamp_i(y + (3), 0, ny - 1); int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)cy * (size_t)nx + (size_t)cx] * mask[342]; }
    output[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
}


// ============================================================================
// Unrolled 1D Continuous Signal Convolutions (Radii 1 to 31)
// ============================================================================

// 1D Signal Convolution: Radius 1 (Filter Length 3), Type float
__kernel void kernel_conv1d_r1_float(
    __global const float* input, __global float* output,
    __constant const float* weights, const uint length) {
    uint gid = get_global_id(0); if (gid >= length) return;
    float sum = 0.0f;
    { int c = clamp_i((int)gid + (-1), 0, (int)length - 1); sum += input[c] * weights[0]; }
    { int c = clamp_i((int)gid + (0), 0, (int)length - 1); sum += input[c] * weights[1]; }
    { int c = clamp_i((int)gid + (1), 0, (int)length - 1); sum += input[c] * weights[2]; }
    output[gid] = sum;
}

// 1D Signal Convolution: Radius 2 (Filter Length 5), Type float
__kernel void kernel_conv1d_r2_float(
    __global const float* input, __global float* output,
    __constant const float* weights, const uint length) {
