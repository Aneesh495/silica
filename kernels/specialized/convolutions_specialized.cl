// Direct 3D Non-Separable Convolution: Kernel 3x3x3
__kernel void kernel_conv3d_direct_3x3x3(
    __global const float* input, __global float* output,
    __constant const float* mask, const int nx, const int ny, const int nz) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
