// 3D Depth Z Convolution: Radius 2 (Window 5), Type float, Boundary clamp
__kernel void kernel_conv3d_z_r2_float_clamp(
    __global const float* input, __global float* output,
    __constant const float* weights, const int width, const int height, const int depth) {
    int x = get_global_id(0); int y = get_global_id(1); int z = get_global_id(2);
    if (x >= width || y >= height || z >= depth) return;
    float sum = 0.0f; size_t slice = (size_t)width * (size_t)height; size_t xy = (size_t)y * (size_t)width + (size_t)x;
    { int cz = clamp_i(z + (-2), 0, depth - 1); sum += input[(size_t)cz * slice + xy] * weights[0]; }
    { int cz = clamp_i(z + (-1), 0, depth - 1); sum += input[(size_t)cz * slice + xy] * weights[1]; }
    { int cz = clamp_i(z + (0), 0, depth - 1); sum += input[(size_t)cz * slice + xy] * weights[2]; }
    { int cz = clamp_i(z + (1), 0, depth - 1); sum += input[(size_t)cz * slice + xy] * weights[3]; }
    { int cz = clamp_i(z + (2), 0, depth - 1); sum += input[(size_t)cz * slice + xy] * weights[4]; }
    output[(size_t)z * slice + xy] = sum;
}

