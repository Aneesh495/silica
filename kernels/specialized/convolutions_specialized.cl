    { int cz = clamp_i(z + (1), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[4]; }
    { int cz = clamp_i(z + (2), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[5]; }
    { int cz = clamp_i(z + (3), 0, nz - 1); sum += input[(size_t)cz * slice + (size_t)y * (size_t)nx + (size_t)x] * dzz_weights[6]; }
    out_dzz[(size_t)z * slice + (size_t)y * (size_t)nx + (size_t)x] = sum;
