    if (x >= nx || y >= ny || z >= nz) return;
    float sum = 0.0f; size_t slice = (size_t)nx * (size_t)ny;
    { int cy = clamp_i(y + (-5), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[0]; }
    { int cy = clamp_i(y + (-4), 0, ny - 1); sum += input[(size_t)z * slice + (size_t)cy * (size_t)nx + (size_t)x] * dyy_weights[1]; }
